# 复制为 backend/.env 后填入真实值。该文件只放占位符，可以提交；backend/.env 不可提交。

# ---- 豆包（火山方舟）大模型 ----
DOUBAO_API_KEY=your_doubao_api_key_here
DOUBAO_MODEL=doubao-seed-2-0-pro-260215
DOUBAO_API_BASE=https://ark.cn-beijing.volces.com/api/v3

# ---- 阿里云百炼（数字人语音合成 / ASR），不用语音功能可留空 ----
DASHSCOPE_API_KEY=
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=

# ---- 会话令牌签名密钥（必填，缺失或短于 32 字符则服务启动即报错）----
# 生成方式：python -c "import secrets;print(secrets.token_hex(32))"
APP_SECRET_KEY=

# ---- 允许的前端来源，逗号分隔。3000=用户端，8080=管理后台 ----
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ---- 可选：覆盖数据库位置，默认 backend/interview.db ----
# INTERVIEW_DB_PATH=

# ---- 可选：Vosk 中文语音模型目录，相对 backend/ 或写绝对路径 ----
VOSK_MODEL_PATH=../../models/vosk-model-small-cn-0.3
